{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    {% render 'image', class: 'product-image', image: image %}
  {% endfor %}
</div>

<div class="product-info">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>
  <p>{{ product.description }}</p>


{% comment %} 1. Current color, server-rendered (works without JS) {% endcomment %}
{% if product.metafields.custom.color_name != blank %}
    <p class="product-color">
      {{ product.metafields.custom.color_group}}: {{ product.metafields.custom.color_name }}
    </p>
{% endif %}

{% comment %} 2. Mount point: React adds the color swatches here {% endcomment %}
<div data-island="color-swatches">
  <script type="application/json">
    { "handle": {{ product.handle | json }} }
  </script>
</div>

<div data-island="size-selector">
  <script type="application/json">
    {
      "selectedId": {{ product.selected_or_first_available_variant.id }},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "title": {{ variant.title | json }},
            "available": {{ variant.available | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

 </div>




<div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    <input type="hidden" name="id" value="{{ current_variant.id }}">

    <input type="text" name="quantity" min="1" value="1">

    {% if product.available %}
      <input type="submit" value="Add to cart">
    {% else %}
      <input type="submit" value="Sold out" disabled>
    {% endif %}
    {{ form | payment_button }}
  {% endform %}
</div>


{% comment %} 3. SEO: product structured data (JSON-LD) for Google {% endcomment %}
<script type="application/ld+json">
   {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
